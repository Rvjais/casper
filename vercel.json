{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": [
        "includes/**",
        "pages/**",
        "index.php"
      ]
    }
  },
  "routes": [
    {
      "src": "/(wp-content/.*|wp-includes/.*|_external/.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
